# Auth.js session secret. Generate a unique random value of at least 32 characters.
AUTH_SECRET=

# Optional canonical URL for Auth.js when it cannot be inferred by the host.
AUTH_URL=

# The single company-owner review account. Never put a plaintext password in source control.
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD_HASH=

# Business-data adapter selection (see src/server/intake/runtime.ts).
# "fake" = in-memory development/test adapter; REJECTED in production.
# Leave unset until the real database adapter is registered.
# DATA_ADAPTER=

# Canonical public site URL for generated absolute URLs (sitemap).
# Optional: when unset, the current production vercel.app domain is used.
# Set this (no trailing slash) when a custom domain is attached.
# NEXT_PUBLIC_SITE_URL=
